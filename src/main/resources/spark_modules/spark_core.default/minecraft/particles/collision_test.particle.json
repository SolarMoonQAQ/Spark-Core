{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "minecraft:collision_test",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles.png"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 12
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.4, 0],
				"direction": [0, -1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 10
			},
			"minecraft:particle_initial_speed": 6,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -9.8, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.5, 0.5],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [0, 72],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 0.45, 0.15, 1]
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.15,
				"collision_drag": 1.5,
				"coefficient_of_restitution": 0.6,
				"expire_on_contact": false,
				"events": [
					{ "event": "collision_hit", "min_speed": 2 },
					{ "event": "collision_hard", "min_speed": 8 }
				]
			}
		},
		"events": {
			"collision_hit": [
				{ "log": "[collision_test] 碰撞（反弹前 |v| ≥ 2 格/秒）" },
				{ "sound_effect": { "sound": "minecraft:block.stone.hit" } }
			],
			"collision_hard": [
				{ "log": "[collision_test] 强碰撞（反弹前 |v| ≥ 8 格/秒）" }
			]
		}
